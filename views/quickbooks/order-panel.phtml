<div class="card mb-4">
    <div class="card-header"><h5 class="mb-0">QuickBooks</h5></div>
    <div class="card-body">
        <?php if ($quickbooks['synced']) : ?>
            <p class="mb-1"><span class="badge bg-success">Pushed to QuickBooks</span></p>
            <p class="small text-muted mb-0">
                <?= $quickbooks['invoiceNumber'] ? 'Invoice ' . \htmlspecialchars((string) $quickbooks['invoiceNumber']) . ', synced ' : 'Synced ' ?>
                <?= \htmlspecialchars((string) $quickbooks['syncedAt']) ?>
            </p>
        <?php elseif ($quickbooks['canPush']) : ?>
            <button type="button" class="btn btn-outline-primary btn-sm w-100" id="pushToQuickBooksBtn">Push to QuickBooks</button>
            <p class="small text-muted mt-2 mb-0">Creates a posted sales invoice in QuickBooks. This cannot be undone from here.</p>
        <?php else : ?>
            <p class="small text-muted mb-0">Only a paid order can be pushed to QuickBooks.</p>
        <?php endif; ?>
    </div>
</div>
<?php if ($quickbooks['canPush']) : ?>
<script nonce="<?= $cspNonce ?? '' ?>">
document.addEventListener('DOMContentLoaded', function () {
    var btn = document.getElementById('pushToQuickBooksBtn');
    if (!btn || !window.osmiumOrder) return;

    btn.addEventListener('click', function () {
        btn.disabled = true;
        window.osmiumOrder.post({ action: 'push_to_quickbooks' }).then(function (data) {
            if (!data.success) {
                window.osmiumOrder.feedback(data.error || 'Could not push to QuickBooks', true);
                btn.disabled = false;
                return;
            }
            window.osmiumOrder.returnToOrder();
        });
    });
});
</script>
<?php endif; ?>
