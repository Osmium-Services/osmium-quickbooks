<script nonce="<?= $cspNonce ?? '' ?>">
window.csrfToken = <?= \json_encode($template['formToken'] ?? '') ?>;

async function postQuickBooksAction(action) {
    const response = await fetch('<?= $admin['basePath'] ?>settings/quickbooks/action/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action, csrf_token: window.csrfToken }),
    });
    return response.json();
}

async function testConnection() {
    const resultEl = document.getElementById('quickbooksActionResult');
    resultEl.textContent = 'Testing...';

    const result = await postQuickBooksAction('test_connection');
    resultEl.innerHTML = '';
    const alert = document.createElement('div');
    alert.className = 'alert mb-0 alert-' + (result.success ? 'success' : 'danger');
    alert.textContent = result.success ? 'Connected to "' + (result.company || '') + '".' : (result.error || 'Connection test failed');
    resultEl.appendChild(alert);
}

async function disconnectQuickBooks() {
    // Not confirm(): native dialogs block browser automation; reconnecting is one click.
    const result = await postQuickBooksAction('disconnect');
    if (result.success) window.location.reload();
    else document.getElementById('quickbooksActionResult').textContent = result.error || 'Failed to disconnect';
}
</script>
